# Copy to .env (git-ignored). docker-compose.yml falls back to these same defaults.
POSTGRES_USER=watch
POSTGRES_PASSWORD=watch
POSTGRES_DB=watchprogress
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used by the server (Phase 1+)
DATABASE_URL=postgresql+asyncpg://watch:watch@127.0.0.1:5432/watchprogress
REDIS_URL=redis://127.0.0.1:6379/0
